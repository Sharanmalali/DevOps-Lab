pipeline {
    agent any
    stages {
        stage('Pre-check Docker') {
            steps {
                script {
                    try {
                        // Check if Docker is installed
                        def dockerVersion = sh(script: 'docker --version', returnStdout: true).trim()
                        if (!dockerVersion) {
                            error "Docker is not installed or not in the PATH. Please install Docker."
                        }

                        // Check if Docker daemon is running
                        def dockerInfo = sh(script: 'docker info', returnStatus: true)
                        if (dockerInfo != 0) {
                            error "Docker daemon is not running. Please start the Docker service."
                        }

                        echo "Docker is available and running: ${dockerVersion}"
                    } catch (Exception e) {
                        error "Pre-check failed: ${e.message}"
                    }
                }
            }
        }
        stage('Setup Workspace') {
            steps {
                script {
                    // Source folder bind-mounted into the Jenkins container by
                    // deploy.sh (brief's "/path/to/your/local/files" placeholder
                    // could never be reached from inside the container).
                    def localSourcePath = env.EX6_SOURCE_DIR ?: '/workspace-src'
                    def workspacePath = env.WORKSPACE

                    // Copy necessary files into the Jenkins workspace
                    sh """
                    cp ${localSourcePath}/delivery_metrics.py ${workspacePath}/
                    cp ${localSourcePath}/prometheus.yml ${workspacePath}/
                    cp ${localSourcePath}/alert_rules.yml ${workspacePath}/
                    cp ${localSourcePath}/Dockerfile ${workspacePath}/
                    cp -r ${localSourcePath}/provisioning ${workspacePath}/
                    """
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                sh 'docker build -t delivery_metrics .'
            }
        }
        stage('Run Application') {
            steps {
                // Host port 8000 is already serving the Step 1 simulator on
                // this machine, so the container publishes 8010 -> 8000.
                // Re-runs: remove any stale container of that name first
                // (the brief's plain `docker run` fails the second time).
                sh '''
                docker rm -f delivery_metrics 2>/dev/null || true
                docker run -d -p 8010:8000 --name delivery_metrics delivery_metrics
                '''
            }
        }
        stage('Run Prometheus & Grafana') {
            steps {
                // Docker-out-of-Docker: the daemon resolves bind-mount
                // sources on the HOST, so workspace paths inside this
                // container are invisible to it. deploy.sh exports
                // EX6_HOST_SRC = this folder's host path (the brief's
                // "/path/to/your/local/files" placeholder).
                sh '''
                docker network inspect ex6-net >/dev/null 2>&1 || docker network create ex6-net
                docker rm -f prometheus grafana 2>/dev/null || true
                SRC="${EX6_HOST_SRC:?EX6_HOST_SRC not set - start Jenkins via deploy.sh}"
                docker run -d --name prometheus --network ex6-net -p 9090:9090 \
                  --add-host=host.docker.internal:host-gateway \
                  --mount "type=bind,source=${SRC}/prometheus.yml,target=/etc/prometheus/prometheus.yml" \
                  --mount "type=bind,source=${SRC}/alert_rules.yml,target=/etc/prometheus/alert_rules.yml" \
                  prom/prometheus
                docker run -d --name grafana --network ex6-net -p 3000:3000 \
                  --mount "type=bind,source=${SRC}/provisioning/datasources,target=/etc/grafana/provisioning/datasources" \
                  --mount "type=bind,source=${SRC}/provisioning/dashboards,target=/etc/grafana/provisioning/dashboards" \
                  grafana/grafana
                '''
            }
        }
        stage('Verify') {
            steps {
                sh '''
                echo "Waiting for the services to come up..."
                sleep 25
                echo "--- delivery metrics (Step 1 process on the host) ---"
                curl -fsS http://host.docker.internal:8000/metrics | grep -E "^pending_deliveries "
                echo "--- Prometheus targets ---"
                curl -fsS http://prometheus:9090/api/v1/targets | grep -o '"health":"up"' | sort | uniq -c
                echo "--- Grafana health ---"
                curl -fsS http://grafana:3000/api/health
                '''
            }
        }
    }
}
